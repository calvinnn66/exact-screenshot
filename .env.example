# Copy this file to .env and fill in all values for local development.
# .env is gitignored — never commit real secrets.
#
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is required for ALL Square and Toast
# server-side features (OAuth, webhooks, catalog sync, order processing).
# Without it, supabaseAdmin throws on first access and every POS server
# function crashes with a hard error.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL — from Supabase Dashboard → Settings → API → Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon (publishable) key — visible in the browser, safe to expose.
# From: Supabase Dashboard → Settings → API → anon / public key.
SUPABASE_PUBLISHABLE_KEY=<anon-key>

# Vite re-exports — same values as above, required for the browser bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Service role key — SERVER ONLY, bypasses RLS.
# REQUIRED for all Square/Toast server functions. Without this key,
# supabaseAdmin throws on first property access and all POS features fail.
# From: Supabase Dashboard → Settings → API → service_role secret (click Reveal).
SUPABASE_SERVICE_ROLE_KEY=

# ── Public base URL ───────────────────────────────────────────────────────────
# Required for Square OAuth redirect and webhook delivery.
# Square requires a public HTTPS URL — use ngrok for local testing:
#   Step 1: ngrok http 8080
#   Step 2: Copy the https://xxxx.ngrok-free.app URL shown in the terminal
#   Step 3: Set PUBLIC_BASE_URL to that URL here (no trailing slash)
#   Step 4: Add <ngrok-url>/api/square/callback as an OAuth redirect URI
#            in: Square Developer Dashboard → your app → OAuth → Redirect URL
#   Step 5: Create a webhook subscription in Square Developer Dashboard →
#            your app → Webhooks → Sandbox → Add subscription →
#            URL: <ngrok-url>/api/public/square/webhook
#   Step 6: Copy the Signature key from that subscription to SQUARE_WEBHOOK_SIGNATURE_KEY
#
# Without PUBLIC_BASE_URL set, publicBaseUrl() falls back to http://localhost:8080,
# which Square will reject for OAuth redirects and webhook delivery.
PUBLIC_BASE_URL=

# ── Square POS integration ────────────────────────────────────────────────────
# From: Square Developer Dashboard → your app → Credentials tab → Sandbox section.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=

# From: Square Developer Dashboard → your app → Webhooks tab → Sandbox →
# your webhook subscription → Signature key (click Show).
# You must create the subscription before this key exists.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ── Toast POS integration ─────────────────────────────────────────────────────
# From: Toast Developer Portal → Webhooks → your subscription → Signature key.
TOAST_WEBHOOK_SIGNATURE_KEY=

# ── AI Scanner ───────────────────────────────────────────────────────────────
# Uses the Lovable AI Gateway (Gemini 2.5 Flash via https://ai.gateway.lovable.dev).
# Not required for POS features — only for AI Scanner image analysis.
LOVABLE_API_KEY=
