# Copy this file to .env and fill in values for local development.
# .env is gitignored — never commit real secrets.
#
# NOTE: Full backend/admin functionality (POS sync, webhooks, catalog mapping)
# runs through Lovable Cloud automatically. You do NOT need SUPABASE_SERVICE_ROLE_KEY
# for normal local frontend development — inventory, UI, and localStorage-based
# features all work without it.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Anon (publishable) key — visible in the browser, safe to share.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-key>

# Vite re-exports — same values as above, required for the browser bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Service role key — SERVER ONLY, bypasses RLS.
# Only needed locally if you are testing POS sync / admin server functions.
# Get it from: Supabase Dashboard → Settings → API → "service_role" secret.
# Leave blank to run in local-dev mode (one-time warning, no spam).
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / Lovable Gateway ──────────────────────────────────────────────────────
# Required to use the AI Scanner (recipe / product / invoice image scan).
# Get it from: Lovable Dashboard → API Keys.
LOVABLE_API_KEY=

# ── Square POS integration ────────────────────────────────────────────────────
# Only needed if connecting Square locally. Managed by Lovable Cloud in production.
# Get from: Square Developer Dashboard → Applications → your app.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Get from: Square Developer Dashboard → Webhooks → Signature key.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ── Toast POS integration ─────────────────────────────────────────────────────
# Only needed if connecting Toast locally. Managed by Lovable Cloud in production.
# Get from: Toast Developer Portal → Webhooks → Signature key.
TOAST_WEBHOOK_SIGNATURE_KEY=

# ── Deployment ────────────────────────────────────────────────────────────────
# Public-facing base URL for OAuth redirect URIs and webhook registration.
# Defaults to the Lovable app URL. Set this only when using a custom domain.
# PUBLIC_BASE_URL=https://yourdomain.com
